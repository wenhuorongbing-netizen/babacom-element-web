+            expect(f.status.value.quality).toBe(ConnectionQuality.Good);
+            f.setRegion("  refreshed-region  ");
+            f.emitRoom(event);
+            expect(f.status.value).toEqual({
+                quality: ConnectionQuality.Unknown,
+                region: "refreshed-region",
