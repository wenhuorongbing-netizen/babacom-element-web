index 0000000000000000000000000000000000000000..128593591f4d650e84af054fe8054b74fe683b5e
--- /dev/null
+++ b/src/state/media/ScreenShareSubscriptions.ts
@@ -0,0 +1,132 @@
+/*
+Copyright 2026 Element Creations Ltd.
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import {
+  type RemoteParticipant,
+  type RemoteTrackPublication,
+  Track,
+  VideoQuality,
+} from "livekit-client";
+import { BehaviorSubject } from "rxjs";
+
+import { type Behavior } from "../Behavior";
+
+const watches = new WeakMap<
+  RemoteParticipant,
+  BehaviorSubject<RemoteTrackPublication | null>
+>();
+
+export function watchingScreenShare$(
+  participant: RemoteParticipant,
+): Behavior<RemoteTrackPublication | null> {
+  return watchState(participant);
+}
+
+export function toggleWatchingScreenShare(
+  participant: RemoteParticipant,
+): void {
+  const video = participant.getTrackPublication(Track.Source.ScreenShare);
+  if (!video || video.isMuted) return;
+  const state = watchState(participant);
+  state.next(state.value === video ? null : video);
+  syncScreenShareSubscriptions(participant);
+}
+
+/** Subscribe to normal call media and only the screen publication the user chose. */
+export function syncScreenShareSubscriptions(
+  participant: RemoteParticipant,
+): void {
+  const state = watchState(participant);
+  const video = participant.getTrackPublication(Track.Source.ScreenShare);
+  const watching =
+    video !== undefined && !video.isMuted && state.value === video;
+  if (!watching && state.value !== null) state.next(null);
+
+  for (const publication of participant.trackPublications.values()) {
+    const desired =
+      publication.source === Track.Source.ScreenShare
+        ? watching && publication === video
+        : publication.source === Track.Source.ScreenShareAudio
+          ? watching
+          : true;
+    if (publication.isDesired !== desired) publication.setSubscribed(desired);
+  }
+  applyScreenShareQuality(participant);
+}
+
+function watchState(
+  participant: RemoteParticipant,
+): BehaviorSubject<RemoteTrackPublication | null> {
+  let state = watches.get(participant);
+  if (!state) {
+    state = new BehaviorSubject<RemoteTrackPublication | null>(null);
+    watches.set(participant, state);
+  }
+  return state;
+}
+
+export type ScreenShareQuality = "auto" | "economy";
+
+const qualityPreferences = new WeakMap<
+  RemoteParticipant,
+  BehaviorSubject<ScreenShareQuality>
+>();
+
+const appliedQuality = new WeakMap<
+  RemoteTrackPublication,
+  ScreenShareQuality
+>();
+
+export function screenShareQuality$(
+  participant: RemoteParticipant,
+): Behavior<ScreenShareQuality> {
+  return qualityState(participant);
+}
+
+export function setScreenShareQuality(
+  participant: RemoteParticipant,
+  quality: ScreenShareQuality,
+): void {
+  const state = qualityState(participant);
+  if (state.value !== quality) {
+    state.next(quality);
+    applyScreenShareQuality(participant);
+  }
+}
+
+function qualityState(
+  participant: RemoteParticipant,
+): BehaviorSubject<ScreenShareQuality> {
+  let state = qualityPreferences.get(participant);
+  if (!state) {
+    state = new BehaviorSubject<ScreenShareQuality>("auto");
+    qualityPreferences.set(participant, state);
+  }
+  return state;
+}
+
+/**
+ * Cap only the chosen screen share video once reconciliation made it desired.
+ * The SDK keeps the max quality per publication, so resend only on a mode change.
+ */
+function applyScreenShareQuality(participant: RemoteParticipant): void {
+  const chosen = watchState(participant).value;
+  const video = participant.getTrackPublication(Track.Source.ScreenShare);
+  if (!video || video.isMuted || chosen !== video || !video.isDesired) return;
+
+  const quality = qualityState(participant).value;
+  const applied = appliedQuality.get(video);
+  if (quality === "economy") {
+    if (applied !== "economy") {
+      video.setVideoQuality(VideoQuality.LOW);
+      appliedQuality.set(video, "economy");
+    }
+  } else if (applied === "economy") {
+    video.setVideoQuality(VideoQuality.HIGH);
+    appliedQuality.set(video, "auto");
+  }
+}
