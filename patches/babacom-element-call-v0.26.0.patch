+        expect(share.setReceiveQuality).toBe(null);
+        expect(share.toggleWatching).toBe(null);
+        expect(share.videoEnabled$.value).toBe(true);
+      } finally {
+        scope.end();
+      }
+    },
+  );
+
+  it("unsubscribes receive quality from former and ended participants", () => {
+    vi.stubEnv("VITE_BABACOM_VOICE", "1");
+    const scope = new ObservableScope();
+    const alice = makeParticipant();
+    const replacement = makeParticipant();
+    const participant$ = new BehaviorSubject<RemoteParticipant | null>(alice);
+    const share = createRemoteScreenShare(scope, {
+      participant$,
+      pretendToBeDisconnected$: new BehaviorSubject(false),
+    } as unknown as RemoteScreenShareInputs);
+
