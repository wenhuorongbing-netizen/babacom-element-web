new file mode 100644
index 0000000000000000000000000000000000000000..1c3c5def639ab3f96ec40637e7761e388beebfd0
--- /dev/null
+++ b/playwright/connection-status.spec.ts
@@ -0,0 +1,45 @@
+/*
+Copyright 2026 Element Creations Ltd.
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import { expect, test } from "@playwright/test";
+
+test("Connection information is shown only in the call", async ({ page }) => {
+    await page.goto("/");
+
+    await page.getByTestId("home_callName").fill("ConnectionStatus");
+    await page.getByTestId("home_displayName").fill("Connection Status User");
+    await page.getByTestId("home_go").click();
+
+    await expect(page.getByTestId("lobby_joinCall")).toBeVisible();
+    await expect(page.getByTestId("connection-status")).toHaveCount(0);
+
+    await page.getByTestId("lobby_joinCall").click();
+
+    const status = page.getByTestId("connection-status");
+    await expect(status).toBeVisible();
+    await expect(status).toHaveAttribute("role", "group");
+    await expect(status).toHaveAccessibleName("Connection information");
+    await expect(status).not.toHaveAttribute("aria-live");
+
+    await expect(
+        status.getByText(
+            /^Connection quality: (Excellent|Good|Poor|Lost|Unknown)$/,
+        ),
+    ).toBeVisible();
+    await expect(status.getByText(/^Media server region: .+$/)).toBeVisible();
+
+    await expect(page.getByTestId("incall_mute")).toBeVisible();
+    await expect(page.getByTestId("incall_screenshare")).toBeVisible();
+    await expect(page.getByTestId("incall_leave")).toBeVisible();
+
+    await page.getByTestId("incall_leave").click();
+
+    await expect(page.getByRole("heading")).toContainText(
+        "your call has ended. How did it go?",
+    );
+    await expect(status).toHaveCount(0);
+});
