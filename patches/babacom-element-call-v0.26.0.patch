+/** Raised when captured system audio cannot exclude this call's playback. */
+export class BabaComSystemAudioError extends Error {
+  public constructor() {
+    super("System audio is unavailable. Try again or share without sound.");
+    this.name = "BabaComSystemAudioError";
+  }
+}
+
+function assertBabaComLoopbackRoute(tracks: LocalTrack[]): void {
+  const audio = tracks.filter(
+    (track) => track.source === Track.Source.ScreenShareAudio,
+  );
+  // Video-only capture is valid.
+  if (audio.length === 0) return;
+  if (audio.length > 1) throw new BabaComSystemAudioError();
+  const mediaStreamTrack = audio[0].mediaStreamTrack;
+  if (mediaStreamTrack.readyState !== "live") {
+    throw new BabaComSystemAudioError();
+  }
+  let settings: MediaTrackSettings;
+  try {
+    settings = mediaStreamTrack.getSettings();
+  } catch {
+    throw new BabaComSystemAudioError();
+  }
+  const route = settings as MediaTrackSettings & {
+    restrictOwnAudio?: boolean;
+  };
+  if (
+    route?.restrictOwnAudio !== true ||
+    route?.deviceId !== "loopbackWithoutChrome"
+  ) {
+    throw new BabaComSystemAudioError();
+  }
+}
+
+async function changeBabaComScreenShare(
+  participant: LocalParticipant,
+  enable: boolean,
+  settings: ScreenShareCaptureOptions,
+  {
+    signal,
+    isCurrent,
+    onPublishing,
+  }: {
+    signal: AbortSignal;
+    isCurrent: () => boolean;
+    onPublishing: () => void;
+  },
+  logger: Logger,
+  publishOptions?: TrackPublishOptions,
+): Promise<void> {
+  if (!enable) {
+    const tracks = [Track.Source.ScreenShare, Track.Source.ScreenShareAudio]
+      .map((source) => participant.getTrackPublication(source)?.track)
+      .filter((track) => track !== undefined);
+    await releaseScreenShareTracks(participant, tracks);
+    return;
+  }
+
+  // Capture stays in the widget click's call stack. Publishing is sequenced so
+  // that a failed audio publication cannot race cleanup of the video.
+  const tracks = await participant.createScreenTracks(settings);
+  const video = tracks.find(
+    (track) => track.source === Track.Source.ScreenShare,
+  );
+  // Stop capture as soon as the user cancels. Unpublish after the in-flight
+  // publish settles so a late publication cannot survive cleanup.
+  const stopCapture = (): void => {
+    for (const track of tracks) track.mediaStreamTrack.stop();
+  };
+  let published = false;
+  try {
+    if (!video) throw new Error("The screen capture returned no video");
+    const captureIsLive = (): boolean =>
+      isCurrent() && video.mediaStreamTrack.readyState === "live";
+    if (!captureIsLive()) return;
+    assertBabaComLoopbackRoute(tracks);
+    if (!captureIsLive()) return;
+    signal.addEventListener("abort", stopCapture, { once: true });
+    onPublishing();
+    for (const track of tracks) {
+      if (!captureIsLive()) return;
+      if (track.source === Track.Source.ScreenShare && publishOptions) {
+        await participant.publishTrack(track, publishOptions);
+      } else {
+        await participant.publishTrack(track);
+      }
+    }
+    published = captureIsLive();
+    const audio = tracks.find(
+      (track) => track.source === Track.Source.ScreenShareAudio,
+    );
+    if (published && audio) {
+      video.mediaStreamTrack.addEventListener(
+        "ended",
+        () => {
+          // LiveKit unpublishes the ended video. Windows loopback can outlive it.
+          void releaseScreenShareTracks(participant, [audio]).catch((error) =>
+            logger.warn(
+              "Could not release system audio after the share ended",
+              error,
+            ),
+          );
+        },
+        { once: true },
+      );
+    }
+  } finally {
+    signal.removeEventListener("abort", stopCapture);
+    if (!published) await releaseScreenShareTracks(participant, tracks);
+  }
+}
+
+async function releaseScreenShareTracks(
+  participant: LocalParticipant,
+  tracks: LocalTrack[],
+): Promise<void> {
+  const results = await Promise.allSettled(
+    tracks.map(async (track) => {
+      try {
+        track.stop();
+      } finally {
+        await participant.unpublishTrack(track, false);
+      }
+    }),
+  );
+  const errors = results.filter((result) => result.status === "rejected");
+  if (errors.length)
+    throw new AggregateError(
+      errors.map((error) => error.reason),
+      "Could not stop all screen share tracks",
+    );
+}
