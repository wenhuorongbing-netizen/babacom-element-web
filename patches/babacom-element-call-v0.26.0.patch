+
+import { afterEach, beforeEach, describe, it, vi } from "vitest";
+import { BehaviorSubject, NEVER, type Observable } from "rxjs";
+import type * as RxJS from "rxjs";
+import { SyncState } from "matrix-js-sdk";
+import { ConnectionState } from "livekit-client";
+
+import { MatrixRTCMode } from "../../config/ConfigOptions.ts";
+import {
+  exampleSfuConfig,
+  exampleTransport,
+  withTestScheduler,
+} from "../../utils/test.ts";
+import { UnknownCallError } from "../../utils/errors.ts";
+import { initializeWidget } from "../../widget.ts";
+import { withCallViewModel } from "./CallViewModelTestUtils.ts";
+
+initializeWidget();
+
+vi.mock("rxjs", async (importOriginal) => ({
+  ...(await importOriginal<typeof RxJS>()),
+  interval: (): Observable<number> => NEVER,
+}));
+vi.mock("@livekit/components-core");
+vi.mock("livekit-client/e2ee-worker?worker");
+vi.mock("../../e2ee/matrixKeyProvider");
+
+describe.each([MatrixRTCMode.Compatibility, MatrixRTCMode.Matrix_2_0])(
+  "CallViewModel failure propagation (%s)",
+  (mode) => {
+    beforeEach(() => {
+      vi.stubGlobal(
+        "fetch",
+        vi
+          .fn<typeof fetch>()
+          .mockResolvedValue(new Response(null, { status: 404 })),
+      );
+    });
+
+    afterEach(() => {
+      vi.unstubAllGlobals();
+    });
+
+    it.each(["active$", "advertised$"] as const)(
+      "exposes a %s transport error through the real local member",
+      (source) => {
+        withTestScheduler(({ expectObservable, schedule }) => {
+          const active$ = new BehaviorSubject({
+            transport: exampleTransport,
+            sfuConfig: exampleSfuConfig,
+          });
+          const advertised$ = new BehaviorSubject(exampleTransport);
+          const error = new UnknownCallError(
+            new Error("synthetic active transport"),
+          );
+
+          withCallViewModel(mode)(
+            {},
+            (vm) => {
+              expectObservable(vm.fatalError$).toBe("a-b", {
+                a: null,
+                b: error,
+              });
+              schedule("--e", {
+                e: () => ({ active$, advertised$ })[source].error(error),
+              });
+            },
+            { localTransport: { active$, advertised$ } },
+          );
+        });
+      },
+    );
+
+    it("does not surface a fatal error for transient reconnecting and syncing states", () => {
+      withTestScheduler(({ expectObservable, schedule }) =>
+        withCallViewModel(mode)(
+          {
+            livekitConnectionState$: new BehaviorSubject(
+              ConnectionState.Connected,
+            ),
+          },
+          (vm, _session, _subjects, setSyncState) => {
+            expectObservable(vm.fatalError$, "^-----!").toBe("a", { a: null });
+            schedule("-r-s", {
+              r: () => setSyncState(SyncState.Reconnecting),
+              s: () => setSyncState(SyncState.Syncing),
+            });
+          },
+        ),
+      );
+    });
+  },
+);
