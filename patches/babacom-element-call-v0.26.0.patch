+      voice.adjustPlaybackVolume(0.4);
+      share.adjustPlaybackVolume(0.7);
+      expect(alice.getVolume(Track.Source.Microphone)).toBe(0.4);
+      expect(alice.getVolume(Track.Source.ScreenShareAudio)).toBe(0.7);
+
+      voice.adjustPlaybackVolume(0);
+      expect(alice.getVolume(Track.Source.Microphone)).toBe(0);
+      expect(alice.getVolume(Track.Source.ScreenShareAudio)).toBe(0.7);
+      voice.adjustPlaybackVolume(0.4);
+      share.adjustPlaybackVolume(0);
+      expect(alice.getVolume(Track.Source.ScreenShareAudio)).toBe(0);
+      expect(alice.getVolume(Track.Source.Microphone)).toBe(0.4);
