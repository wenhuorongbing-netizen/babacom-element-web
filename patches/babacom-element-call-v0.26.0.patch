+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import { ConnectionQuality, RoomEvent, type Participant } from "livekit-client";
+import { distinctUntilChanged, Observable, of, switchMap } from "rxjs";
+
+import { type Behavior } from "../Behavior.ts";
+import { type ObservableScope } from "../ObservableScope.ts";
+import {
+    ConnectionState,
+    type Connection,
+} from "./remoteMembers/Connection.ts";
+
+export interface ConnectionStatus {
+    readonly quality: ConnectionQuality;
+    readonly region: string | null;
+}
+
+const UNKNOWN: ConnectionStatus = {
+    quality: ConnectionQuality.Unknown,
+    region: null,
+};
+
+const statusEquals = (a: ConnectionStatus, b: ConnectionStatus): boolean =>
+    a.quality === b.quality && a.region === b.region;
+
+const normalizeRegion = (raw: unknown): string | null => {
+    if (typeof raw !== "string") return null;
+    const trimmed = raw.trim();
+    return trimmed.length > 0 ? trimmed : null;
+};
+
+const isLivekitConnected = (state: unknown): boolean =>
+    state === ConnectionState.LivekitConnected;
+
+function connectionStatus$(
+    connection: Connection,
+): Observable<ConnectionStatus> {
+    return new Observable<ConnectionStatus>((subscriber) => {
+        const room = connection.livekitRoom;
+        let disposed = false;
+        let connected = isLivekitConnected(connection.state$.value);
+        // An already-connected connection may seed a cached quality from the local getter snapshot.
+        // Any later connection/reconnection transition discards that cache for good.
+        let quality: ConnectionQuality = connected
+            ? room.localParticipant.connectionQuality
+            : ConnectionQuality.Unknown;
+
+        const emit = (): void => {
+            subscriber.next(
+                connected
+                    ? {
+                          quality,
+                          region: normalizeRegion(room.serverInfo?.region),
+                      }
+                    : { quality: ConnectionQuality.Unknown, region: null },
+            );
+        };
+
+        const invalidate = (): void => {
+            quality = ConnectionQuality.Unknown;
+        };
+
+        const onState = (state: unknown): void => {
+            if (disposed) return;
+            const wasConnected = connected;
+            connected = isLivekitConnected(state);
+            // Leaving or (re)entering connected waits for a fresh local-participant quality event.
+            if (!connected || !wasConnected) invalidate();
+            emit();
+        };
+
+        const onQualityChanged = (
+            q: ConnectionQuality,
+            participant: Participant,
+        ): void => {
+            if (disposed || !connected) return;
+            // Reject remote participants, including a remote impersonating the local identity.
+            if (participant !== room.localParticipant) return;
+            quality = q;
+            emit();
+        };
+
+        const onConnectedOrReconnected = (): void => {
+            if (disposed) return;
+            invalidate();
+            emit();
+        };
+
+        room.on(RoomEvent.ConnectionQualityChanged, onQualityChanged);
+        room.on(RoomEvent.Connected, onConnectedOrReconnected);
+        room.on(RoomEvent.Reconnected, onConnectedOrReconnected);
+
+        const stateSub = connection.state$.subscribe(onState);
+        emit();
+
+        return () => {
+            disposed = true;
+            stateSub.unsubscribe();
+            room.off(RoomEvent.ConnectionQualityChanged, onQualityChanged);
+            room.off(RoomEvent.Connected, onConnectedOrReconnected);
+            room.off(RoomEvent.Reconnected, onConnectedOrReconnected);
+        };
+    });
+}
+
+export function createConnectionStatus$(
+    scope: ObservableScope,
+    connection$: Observable<Connection | null>,
+): Behavior<ConnectionStatus> {
+    const observable$ = connection$.pipe(
+        // Re-emitting the same connection must not re-subscribe: that would reattach listeners and
+        // replace a fresher quality with the cached snapshot.
+        distinctUntilChanged(),
+        switchMap((connection) =>
+            connection === null ? of(UNKNOWN) : connectionStatus$(connection),
+        ),
+        distinctUntilChanged(statusEquals),
+    );
+    return scope.behavior(observable$, UNKNOWN);
+}
