+/*
+Copyright 2026 Element Creations Ltd.
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import {
+  type RemoteParticipant,
+  type RemoteTrackPublication,
+  Track,
+  VideoQuality,
+} from "livekit-client";
+import { describe, expect, it, vi } from "vitest";
+
+import {
+  screenShareQuality$,
+  setScreenShareQuality,
+  syncScreenShareSubscriptions,
+  toggleWatchingScreenShare,
+  watchingScreenShare$,
+} from "./ScreenShareSubscriptions";
+
+describe("BabaCom screen subscriptions", () => {
+  it("opts in to the current video and late audio, leaves voice subscribed, and revokes on replacement", () => {
+    const voice = publication(Track.Source.Microphone);
+    const video = publication(Track.Source.ScreenShare);
+    const audio = publication(Track.Source.ScreenShareAudio);
+    const tracks = new Map([
+      ["voice", voice],
+      ["screen", video],
+    ]);
+    const participant = {
+      trackPublications: tracks,
+      getTrackPublication: (source: Track.Source) =>
+        [...tracks.values()].find((track) => track.source === source),
+    } as unknown as RemoteParticipant;
+
+    syncScreenShareSubscriptions(participant);
+    expect(voice.isDesired).toBe(true);
+    expect(video.isDesired).toBe(false);
+    toggleWatchingScreenShare(participant);
+    expect(video.isDesired).toBe(true);
+    expect(watchingScreenShare$(participant).value).toBe(video);
+
+    tracks.set("audio", audio);
+    syncScreenShareSubscriptions(participant);
+    expect(audio.isDesired).toBe(true);
+
+    toggleWatchingScreenShare(participant);
+    expect(video.isDesired).toBe(false);
+    expect(audio.isDesired).toBe(false);
+    expect(voice.isDesired).toBe(true);
+
+    toggleWatchingScreenShare(participant);
+    const replacement = publication(Track.Source.ScreenShare);
+    tracks.set("screen", replacement);
+    syncScreenShareSubscriptions(participant);
+    expect(watchingScreenShare$(participant).value).toBeNull();
+    expect(replacement.isDesired).toBe(false);
+    expect(audio.isDesired).toBe(false);
+    expect(voice.setSubscribed).toHaveBeenCalledExactlyOnceWith(true);
+  });
+
+  it("pre-watch quality preferences do not subscribe or touch media", () => {
+    const voice = publication(Track.Source.Microphone);
+    const video = publication(Track.Source.ScreenShare);
+    const audio = publication(Track.Source.ScreenShareAudio);
+    const tracks = new Map([
+      ["voice", voice],
+      ["screen", video],
+      ["audio", audio],
+    ]);
+    const participant = {
+      trackPublications: tracks,
+      getTrackPublication: (source: Track.Source) =>
+        [...tracks.values()].find((track) => track.source === source),
+    } as unknown as RemoteParticipant;
+    const other = {} as unknown as RemoteParticipant;
+
+    expect(screenShareQuality$(participant).value).toBe("auto");
+    setScreenShareQuality(participant, "economy");
+    expect(screenShareQuality$(participant).value).toBe("economy");
+    setScreenShareQuality(participant, "auto");
+    expect(screenShareQuality$(participant).value).toBe("auto");
+    expect(watchingScreenShare$(participant).value).toBeNull();
+
+    for (const track of [video, audio, voice]) {
+      expect(track.setSubscribed).not.toHaveBeenCalled();
+      expect(track.setVideoQuality).not.toHaveBeenCalled();
+    }
+
+    expect(screenShareQuality$(other).value).toBe("auto");
+  });
+
+  it("economy quality caps only the watched screen-share video", () => {
+    const voice = publication(Track.Source.Microphone);
+    const video = publication(Track.Source.ScreenShare);
+    const audio = publication(Track.Source.ScreenShareAudio);
+    const tracks = new Map([
+      ["voice", voice],
+      ["screen", video],
+      ["audio", audio],
+    ]);
+    const participant = {
+      trackPublications: tracks,
+      getTrackPublication: (source: Track.Source) =>
+        [...tracks.values()].find((track) => track.source === source),
+    } as unknown as RemoteParticipant;
+
+    expect(screenShareQuality$(participant).value).toBe("auto");
+    toggleWatchingScreenShare(participant);
+    syncScreenShareSubscriptions(participant);
+    vi.mocked(video.setVideoQuality).mockImplementation(() => {
+      expect(video.isDesired).toBe(true);
+    });
+    setScreenShareQuality(participant, "economy");
+
+    expect(video.setVideoQuality).toHaveBeenCalledExactlyOnceWith(
+      VideoQuality.LOW,
+    );
+    expect(voice.setVideoQuality).not.toHaveBeenCalled();
+    expect(audio.setVideoQuality).not.toHaveBeenCalled();
+    expect(voice.isDesired).toBe(true);
+    expect(audio.isDesired).toBe(true);
+
+    setScreenShareQuality(participant, "auto");
+    expect(video.setVideoQuality).toHaveBeenLastCalledWith(VideoQuality.HIGH);
+    expect(video.setVideoQuality).toHaveBeenCalledTimes(2);
+    setScreenShareQuality(participant, "auto");
+    syncScreenShareSubscriptions(participant);
+    expect(video.setVideoQuality).toHaveBeenCalledTimes(2);
+
+    // Re-apply economy, then stop/re-watch: no LOW resend for this publication.
+    setScreenShareQuality(participant, "economy");
+    vi.mocked(video.setVideoQuality).mockClear();
+    toggleWatchingScreenShare(participant);
+    toggleWatchingScreenShare(participant);
+    expect(video.isDesired).toBe(true);
+    expect(video.setVideoQuality).not.toHaveBeenCalled();
+
+    // While stopped, a preference change must not subscribe or cap anything.
+    toggleWatchingScreenShare(participant);
+    for (const track of [voice, video, audio]) {
+      vi.mocked(track.setSubscribed).mockClear();
+      vi.mocked(track.setVideoQuality).mockClear();
+    }
+    setScreenShareQuality(participant, "auto");
+    setScreenShareQuality(participant, "economy");
+    expect(watchingScreenShare$(participant).value).toBeNull();
+    for (const track of [voice, video, audio]) {
+      expect(track.setSubscribed).not.toHaveBeenCalled();
+      expect(track.setVideoQuality).not.toHaveBeenCalled();
+    }
+
+    // A replacement is inert until a fresh opt-in, then LOW exactly once.
+    const replacement = publication(Track.Source.ScreenShare);
+    tracks.set("screen", replacement);
+    syncScreenShareSubscriptions(participant);
+    expect(replacement.setSubscribed).not.toHaveBeenCalled();
+    expect(replacement.setVideoQuality).not.toHaveBeenCalled();
+    toggleWatchingScreenShare(participant);
+    expect(replacement.isDesired).toBe(true);
+    expect(replacement.setVideoQuality).toHaveBeenCalledExactlyOnceWith(
+      VideoQuality.LOW,
+    );
+    expect(voice.setVideoQuality).not.toHaveBeenCalled();
+    expect(audio.setVideoQuality).not.toHaveBeenCalled();
+  });
+});
+
+function publication(source: Track.Source): RemoteTrackPublication {
+  const track = {
+    source,
+    isDesired: false,
+    isMuted: false,
+    setSubscribed: vi.fn((subscribed: boolean) => {
+      track.isDesired = subscribed;
+    }),
+    setVideoQuality: vi.fn(),
+  };
+  return track as unknown as RemoteTrackPublication;
+}
