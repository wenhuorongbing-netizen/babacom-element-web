+    ).toBeVisible();
+
+    const combobox = screen.getByRole("combobox", { name: "Receive quality" });
+    const options = screen.getAllByRole("option");
+    expect(options).toHaveLength(2);
+    expect(options.map((o) => (o as HTMLOptionElement).value)).toEqual([
+      "auto",
+      "economy",
