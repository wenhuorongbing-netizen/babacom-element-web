+    // Sinks are unsubscribed: sliders after end must not touch volumes.
+    voice.adjustPlaybackVolume(0.9);
+    share.adjustPlaybackVolume(0.9);
+    expect(replacement.getVolume(Track.Source.Microphone)).toBe(0.4);
+    expect(replacement.getVolume(Track.Source.ScreenShareAudio)).toBe(0.7);
+  });
+
+  it("records economy receive quality on the current participant without watching", () => {
+    vi.stubEnv("VITE_BABACOM_VOICE", "1");
+    const scope = new ObservableScope();
+    const alice = makeParticipant();
+    const share = createRemoteScreenShare(scope, {
+      participant$: new BehaviorSubject(alice),
+      pretendToBeDisconnected$: new BehaviorSubject(false),
+    } as unknown as RemoteScreenShareInputs);
+
+    try {
+      expect(share.receiveQuality$.value).toBe("auto");
+      share.setReceiveQuality!("economy");
+      expect(share.receiveQuality$.value).toBe("economy");
+      expect(screenShareQuality$(alice).value).toBe("economy");
+      expect(watchingScreenShare$(alice).value).toBe(null);
+    } finally {
