new file mode 100644
index 0000000000000000000000000000000000000000..994ddc7df5ea4965d62313bfe23e1031c6ca00dc
--- /dev/null
+++ b/src/state/CallViewModel/connectionStatus.ts
@@ -0,0 +1,125 @@
+/*
