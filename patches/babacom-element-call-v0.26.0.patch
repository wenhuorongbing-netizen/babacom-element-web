+    it("clears status when the state becomes an Error", () => {
+        const f = setup();
+        f.select();
+        f.emitQuality(ConnectionQuality.Good, f.local);
+        expect(f.status.value.quality).toBe(ConnectionQuality.Good);
+        f.state$.next(new Error("boom"));
+        expect(f.status.value).toEqual(UNKNOWN);
+        f.emitQuality(ConnectionQuality.Poor, f.local);
+        expect(f.status.value).toEqual(UNKNOWN);
+        f.end();
+    });
+
+    it("does not revert fresh quality or reattach listeners for a repeated connection object", () => {
+        const f = setup();
+        f.select();
+        f.emitQuality(ConnectionQuality.Good, f.local);
+        expect(f.status.value.quality).toBe(ConnectionQuality.Good);
+        const onCalls = f.onSpy.mock.calls.length;
+        expect(onCalls).toBeGreaterThan(0);
+        f.select();
+        expect(f.status.value.quality).toBe(ConnectionQuality.Good);
+        expect(f.onSpy).toHaveBeenCalledTimes(onCalls);
+        f.emitQuality(ConnectionQuality.Poor, f.local);
+        expect(f.status.value.quality).toBe(ConnectionQuality.Poor);
+        f.end();
+    });
+
+    it("detaches and ignores the old room and state after replacement", () => {
+        const f = setup();
+        f.select();
+        f.emitQuality(ConnectionQuality.Good, f.local);
+        const replacement = makeConnection();
+        f.connection$.next(replacement.connection);
+        for (const args of f.onSpy.mock.calls) {
+            expect(f.offSpy).toHaveBeenCalledWith(args[0], args[1]);
+        }
+        expect(replacement.onSpy).toHaveBeenCalled();
+        f.emitQuality(ConnectionQuality.Poor, f.local);
+        f.state$.next(ConnectionState.LivekitConnected);
+        expect(f.status.value.quality).not.toBe(ConnectionQuality.Poor);
