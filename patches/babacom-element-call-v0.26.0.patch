+
+    expect(vm.receiveQuality$.value).toBe("economy");
+    expect(vm.watching$.value).toBe(false);
+    expect(
+      screen.getByRole("button", { name: /watch screen share/i }),
+    ).toBeVisible();
+    await user.selectOptions(
+      screen.getByRole("combobox", { name: "Receive quality" }),
+      "auto",
+    );
+    expect(vm.receiveQuality$.value).toBe("auto");
+    expect(vm.watching$.value).toBe(false);
+
+    // jsdom reports zero-sized rectangles, so check real layout only in a browser.
+    if (!navigator.userAgent.includes("jsdom")) {
+      const selectRect = screen
+        .getByRole("combobox", { name: "Receive quality" })
+        .getBoundingClientRect();
+      const watchRect = screen
+        .getByRole("button", { name: /watch screen share/i })
+        .getBoundingClientRect();
+      for (const rect of [selectRect, watchRect]) {
+        expect(rect.width).toBeGreaterThan(0);
+        expect(rect.height).toBeGreaterThan(0);
+        expect(rect.left).toBeGreaterThanOrEqual(0);
+        expect(rect.top).toBeGreaterThanOrEqual(0);
+        expect(rect.right).toBeLessThanOrEqual(window.innerWidth);
+        expect(rect.right).toBeLessThanOrEqual(360);
+        expect(rect.bottom).toBeLessThanOrEqual(window.innerHeight);
+      }
+      const separated =
+        selectRect.right <= watchRect.left ||
+        watchRect.right <= selectRect.left ||
+        selectRect.bottom <= watchRect.top ||
+        watchRect.bottom <= selectRect.top;
+      expect(separated).toBe(true);
+    }
+    expect(await axe(container)).toHaveNoViolations();
+  } finally {
+    vi.unstubAllEnvs();
+  }
+});
