+    ConnectionState,
+    type Connection,
+} from "./remoteMembers/Connection.ts";
+import { mockLivekitRoom, mockLocalParticipant } from "../../utils/test.ts";
+
+const UNKNOWN = { quality: ConnectionQuality.Unknown, region: null };
+
+const NONCONNECTED_STATES = [
+    ConnectionState.Initialized,
+    ConnectionState.FetchingConfig,
+    ConnectionState.Stopped,
+    ConnectionState.LivekitDisconnected,
+    ConnectionState.LivekitConnecting,
+    ConnectionState.LivekitReconnecting,
+    ConnectionState.LivekitSignalReconnecting,
+];
+
+const RECONNECT_STATES = [
+    ConnectionState.LivekitReconnecting,
+    ConnectionState.LivekitSignalReconnecting,
+];
+
+describe("createConnectionStatus$", () => {
+    it("reports Unknown/null when nothing is selected", () => {
+        const f = setup();
+        expect(f.status.value).toEqual(UNKNOWN);
+        f.end();
+    });
+
+    it.each(NONCONNECTED_STATES)(
+        "reports Unknown/null for state %s",
+        (state) => {
+            const f = setup({ initialState: state });
+            f.select();
+            expect(f.status.value).toEqual(UNKNOWN);
+            f.emitQuality(ConnectionQuality.Good, f.local);
+            expect(f.status.value).toEqual(UNKNOWN);
+            f.end();
+        },
+    );
+
+    it("trims the connected room's region", () => {
+        const f = setup();
+        f.setRegion("  eu-west-1  ");
+        f.select();
+        f.emitQuality(ConnectionQuality.Good, f.local);
+        expect(f.status.value).toEqual({
+            quality: ConnectionQuality.Good,
+            region: "eu-west-1",
+        });
+        f.end();
+    });
+
+    it("seeds the initial connected snapshot before any quality event", () => {
+        const f = setup();
+        f.select();
+        expect(f.status.value).toEqual({
+            quality: ConnectionQuality.Excellent,
+            region: "eu-west-1",
+        });
+        f.end();
+    });
+
+    it("deduplicates equivalent status without losing later updates", () => {
+        const f = setup();
+        f.select();
+        const seen = vi.fn();
+        const sub = f.status.subscribe(seen);
+        expect(seen).toHaveBeenCalledTimes(1);
+        f.emitQuality(ConnectionQuality.Good, f.local);
+        expect(seen).toHaveBeenCalledTimes(2);
+        f.emitQuality(ConnectionQuality.Good, f.local);
+        f.state$.next(ConnectionState.LivekitConnected);
+        expect(seen).toHaveBeenCalledTimes(2);
+        f.emitQuality(ConnectionQuality.Poor, f.local);
+        expect(seen).toHaveBeenCalledTimes(3);
+        f.end();
+        f.emitQuality(ConnectionQuality.Excellent, f.local);
+        f.state$.next(ConnectionState.LivekitDisconnected);
+        expect(seen).toHaveBeenCalledTimes(3);
+        sub.unsubscribe();
+    });
+
+    it("accepts quality only from the exact current local participant", () => {
+        const f = setup();
+        f.select();
+        const remote = mockLocalParticipant({
+            identity: "remote-id",
+            connectionQuality: ConnectionQuality.Poor,
+        });
+        const impostor = mockLocalParticipant({
+            identity: f.local.identity,
+            connectionQuality: ConnectionQuality.Poor,
+        });
+        f.emitQuality(ConnectionQuality.Poor, remote);
+        expect(f.status.value.quality).not.toBe(ConnectionQuality.Poor);
+        f.emitQuality(ConnectionQuality.Poor, impostor);
+        expect(f.status.value.quality).not.toBe(ConnectionQuality.Poor);
+        f.emitQuality(ConnectionQuality.Good, f.local);
+        expect(f.status.value.quality).toBe(ConnectionQuality.Good);
+        f.emitQuality(ConnectionQuality.Poor, f.local);
+        expect(f.status.value.quality).toBe(ConnectionQuality.Poor);
+        f.end();
+    });
+
+    it.each([{ region: undefined }, { region: "" }, { region: "  " }])(
