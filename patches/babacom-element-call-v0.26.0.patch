+        expect(f.status.value).toEqual(UNKNOWN);
+        for (const args of f.onSpy.mock.calls) {
+            expect(f.offSpy).toHaveBeenCalledWith(args[0], args[1]);
+        }
+        f.emitQuality(ConnectionQuality.Poor, f.local);
+        expect(f.status.value).toEqual(UNKNOWN);
+        f.end();
+    });
+
+    it("shares one listener set between two consumers and detaches it on scope end", () => {
+        const f = setup();
+        f.select();
+        const onCalls = f.onSpy.mock.calls.length;
+        expect(onCalls).toBeGreaterThan(0);
+        const seenA = vi.fn();
+        const seenB = vi.fn();
+        const subA = f.status.subscribe((value): void => {
+            seenA(value);
+        });
+        const subB = f.status.subscribe((value): void => {
+            seenB(value);
+        });
+        expect(f.onSpy).toHaveBeenCalledTimes(onCalls);
+        expect(seenA).toHaveBeenCalled();
+        expect(seenB).toHaveBeenCalled();
+        f.emitQuality(ConnectionQuality.Good, f.local);
+        expect(f.status.value).toEqual({
+            quality: ConnectionQuality.Good,
+            region: "eu-west-1",
+        });
+        f.end();
+        for (const args of f.onSpy.mock.calls) {
+            expect(f.offSpy).toHaveBeenCalledWith(args[0], args[1]);
+        }
+        subA.unsubscribe();
+        subB.unsubscribe();
+    });
+
+    it("attaches no listeners when the scope has already ended", () => {
+        const scope = new ObservableScope();
+        scope.end();
+        const connection$ = new BehaviorSubject<Connection | null>(null);
+        const status = createConnectionStatus$(scope, connection$);
+        const conn = makeConnection();
+        connection$.next(conn.connection);
+        expect(status.value).toEqual(UNKNOWN);
+        expect(conn.onSpy).not.toHaveBeenCalled();
+        conn.emitQuality(ConnectionQuality.Good, conn.local);
+        expect(status.value).toEqual(UNKNOWN);
+        expect(conn.offSpy).not.toHaveBeenCalled();
+    });
+});
+
+type Options = { initialState?: ConnectionState | Error };
+
+function emitRoomEvent(room: Room, event: RoomEvent, ...args: unknown[]): void {
+    (
+        room as unknown as { emit(event: RoomEvent, ...args: unknown[]): void }
+    ).emit(event, ...args);
+}
+
+function setServerRegion(room: Room, region: string | undefined): void {
+    Object.defineProperty(room, "serverInfo", {
+        value: region === undefined ? undefined : { region },
+        configurable: true,
+    });
+}
+
+function makeConnection(options: Options = {}) {
+    const local = mockLocalParticipant({
+        identity: "local-id",
+        connectionQuality: ConnectionQuality.Excellent,
+    });
+    const room = mockLivekitRoom({ localParticipant: local });
+    setServerRegion(room, "  eu-west-1  ");
+    const onSpy = vi.spyOn(room, "on");
+    const offSpy = vi.spyOn(room, "off");
+    const state$ = new BehaviorSubject<ConnectionState | Error>(
+        options.initialState ?? ConnectionState.LivekitConnected,
+    );
+    const connection = { state$, livekitRoom: room } as unknown as Connection;
+    return {
+        local,
+        room,
+        onSpy,
+        offSpy,
+        state$,
+        connection,
+        setRegion: (region: string | undefined): void =>
+            setServerRegion(room, region),
+        emitQuality: (
+            quality: ConnectionQuality,
+            participant: Participant,
+        ): void =>
+            emitRoomEvent(
+                room,
+                RoomEvent.ConnectionQualityChanged,
+                quality,
+                participant,
+            ),
+        emitRoom: (event: RoomEvent.Connected | RoomEvent.Reconnected): void =>
+            emitRoomEvent(room, event),
+    };
+}
+
+function setup(options: Options = {}) {
+    const scope = new ObservableScope();
+    const connection$ = new BehaviorSubject<Connection | null>(null);
+    const status = createConnectionStatus$(scope, connection$);
+    const conn = makeConnection(options);
+    return {
+        ...conn,
+        scope,
+        connection$,
+        status,
+        select: (): void => connection$.next(conn.connection),
+        end: (): void => scope.end(),
+    };
+}
